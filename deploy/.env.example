# =====================================================================
# SmartBrief 容器化部署环境变量示例
# 用法：cp .env.example .env 后填入真实 Key（docker compose 自动读取 .env）
# =====================================================================

# ---------- 大模型（必填，OpenAI 兼容接口）----------
# 支持 OpenAI / DeepSeek / Kimi / Ollama 等任何兼容接口
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# ---------- RAG 知识库嵌入（可选，未配置则知识库为空但不影响任务执行）----------
# SiliconFlow bge-m3（与本地开发一致的嵌入模型）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- EXA 搜索（可选，技能中心「EXA 搜索」与 research 智能体）----------
# 未配置时 EXA 技能报错，research 智能体回退 MCP Bing 搜索
EXA_API_KEY=

# 主备模型可选；任务切备用后不在任务内回切，不新增收费健康探测。
MODEL_FAILOVER_ENABLED=false
OPENAI_PROVIDER=primary
BACKUP_OPENAI_BASE_URL=
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_MODEL=
BACKUP_OPENAI_PROVIDER=backup
MODEL_FAILOVER_TOTAL_SECONDS=120
MODEL_FAILOVER_MAX_ATTEMPTS=2
MODEL_CIRCUIT_COOLDOWN_SECONDS=60
# MODEL_PRICES_JSON可用provider:model键隔离主备价格；缓存命中需cache_read_per_million。
# 写入另收费时配置cache_write_per_million及cache_write_mode=included|additional；缺统计/价格保留未知。

# ---------- 模型调用策略（可选，注释值为默认）----------
# 单任务所有模型调用累计 Token 预算；调用前按 UTF-8 字节+完成预留保守扣账
# 注意：这是保守预留而非严格 Token/金额封顶；改后需重启 backend 容器生效
# MAX_TASK_TOKENS=20000
# MODEL_COMPLETION_RESERVE=2048
# MODEL_TIMEOUT_SECONDS=90
# MODEL_MAX_RETRIES=1

# ---------- 可选开关 ----------
# 长期记忆总开关（默认开启；关闭后 remember/recall 短路，已存数据不清空）
# MEMORY_ENABLED=true
# 容器时区（东八区示例，影响日志与 SQLite 本地时间字段）
# TZ=Asia/Shanghai
