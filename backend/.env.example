# SmartBrief 后端配置示例：复制为 .env 并填入真实值
# 支持任意 OpenAI 兼容接口（DeepSeek / Kimi / Ollama 等），只需改 BASE_URL 与 MODEL

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini

# ===== 嵌入模型配置（RAG，复用 SiliconFlow 兼容 OpenAI Embeddings 接口）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# 两个不同的随机令牌，至少32字符；不配置管理员则接口拒绝访问
SMARTBRIEF_ADMIN_TOKEN=
SMARTBRIEF_READONLY_TOKEN=
SMARTBRIEF_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
