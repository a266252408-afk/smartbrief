# SmartBrief 后端配置：请填入真实 API 信息
# 支持任意 OpenAI 兼容接口（DeepSeek / Kimi / Ollama 等），只需改 BASE_URL 与 MODEL

OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 可选主备容灾：独立供应商/地址更能隔离故障；仅启用后校验备用配置。
# 任务一旦切备用，本任务和恢复均固定备用；冷却后的新任务才试探主模型。
MODEL_FAILOVER_ENABLED=true
OPENAI_PROVIDER=primary
BACKUP_OPENAI_BASE_URL=
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_MODEL=
BACKUP_OPENAI_PROVIDER=backup
# 主备合计尝试与时间上限；主调用最多使用剩余时间一半，给备用留时间。
MODEL_FAILOVER_TOTAL_SECONDS=900
MODEL_FAILOVER_MAX_ATTEMPTS=2
MODEL_CIRCUIT_COOLDOWN_SECONDS=60

# ===== 嵌入模型配置（RAG，兼容 OpenAI Embeddings 接口）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 本地管理员访问令牌；不提交到Git
SMARTBRIEF_ADMIN_TOKEN=

# 只读令牌（留空则无只读账号）；管理员不能为空、令牌不含空白，两角色不可同值
SMARTBRIEF_READONLY_TOKEN=
SMARTBRIEF_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 仅所有者信任代码时显式启用；不是Python沙箱
SMARTBRIEF_ALLOW_SKILL_PYTHON=false
SMARTBRIEF_ALLOW_SKILL_SCRIPTS=false

# 模型调用策略：SDK内部不重试；业务层仅重试超时/连接/429/5xx
# 单任务所有模型调用累计的Token预算；Token未知时按UTF-8消息/工具字节与完成预留扣账
# 注意：保守预留，不是严格Token或金额封顶
MAX_TASK_TOKENS=1000000
MODEL_COMPLETION_RESERVE=16384
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=1

# 可选单价，按每百万输入/输出Token配置；没有默认价格/币种，空值为费用未知
# MODEL_PRICES_JSON={"qwen3.7-flash":{"input_per_million":1.0,"output_per_million":2.0,"currency":"CNY"}}
MODEL_PRICES_JSON='{"primary:qwen3.7-flash":{"input_per_million":0.2,"output_per_million":0.8,"cache_read_per_million":0.04,"currency":"CNY"}}'

# 报告任务全局并发；同一业务库仅允许一个Uvicorn worker
MAX_CONCURRENT_TASKS=2

#EXA搜索api
EXA_API_KEY=
PRIMARY_MODEL_COMPLETION_RESERVE=16384
PRIMARY_MODEL_TIMEOUT_SECONDS=300
BACKUP_MODEL_COMPLETION_RESERVE=32768
BACKUP_MODEL_TIMEOUT_SECONDS=450
GLM_MODEL_MAX_OUTPUT_TOKENS=32768


