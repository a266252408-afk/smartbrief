# SmartBrief 后端配置示例：复制为 .env 并填入真实值
# 支持任意 OpenAI 兼容接口（DeepSeek / Kimi / Ollama 等），只需改 BASE_URL 与 MODEL

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
# 可选：审核/返工独立模型；未配置时回退 OPENAI_MODEL。只改模型名，不新增密钥。
REVIEW_OPENAI_MODEL=
REWRITE_OPENAI_MODEL=

# 可选主备容灾：独立供应商/地址更能隔离故障；仅启用后校验备用配置。
# 任务一旦切备用，本任务和恢复均固定备用；冷却后的新任务才试探主模型。
MODEL_FAILOVER_ENABLED=false
OPENAI_PROVIDER=primary
BACKUP_OPENAI_BASE_URL=
BACKUP_OPENAI_API_KEY=
BACKUP_OPENAI_MODEL=
BACKUP_OPENAI_PROVIDER=backup
# 主备合计尝试与时间上限；主调用最多使用剩余时间一半，给备用留时间。
MODEL_FAILOVER_TOTAL_SECONDS=900
MODEL_FAILOVER_MAX_ATTEMPTS=2
MODEL_CIRCUIT_COOLDOWN_SECONDS=60

# ===== 嵌入模型配置（RAG，复用 SiliconFlow 兼容 OpenAI Embeddings 接口）=====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ===== EXA 搜索（可选，技能中心「EXA 搜索」与 research 智能体）=====
# 未配置时「EXA 搜索」技能返回明确错误，research 智能体回退 MCP Bing 搜索
EXA_API_KEY=

# 令牌按.env中的值匹配，不限制位数；管理员不能为空、令牌不含空白，两角色不可同值
SMARTBRIEF_ADMIN_TOKEN=
SMARTBRIEF_READONLY_TOKEN=
SMARTBRIEF_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 仅所有者信任代码时显式启用；不是Python沙箱
SMARTBRIEF_ALLOW_SKILL_PYTHON=false
SMARTBRIEF_ALLOW_SKILL_SCRIPTS=false

# 模型调用策略：SDK内部不重试；业务层仅重试超时/连接/429/5xx
# 统一思考档位：low / high / max；当前适用于 GLM-5.3 系列的全部 Agent 与独立评测。
# 未确认支持该参数的模型（如 qwen3.7-flash）保留原参数；修改后重启后端。
MODEL_REASONING_EFFORT=high
MAX_TASK_TOKENS=1000000
# 全任务共享调用数与累计模型秒数，重试/主备/协议纠正/裁决均累计；恢复不清零。
MAX_TASK_MODEL_CALLS=100
MAX_TASK_MODEL_SECONDS=3600
MODEL_COMPLETION_RESERVE=16384
MODEL_TIMEOUT_SECONDS=300
MODEL_MAX_RETRIES=1
# 主备各自的输出上限与超时；未配置时回退上面的通用值。
# 备用模型若带思考过程，完成预留需同时容纳思考与正文，否则会返回空正文。
# 若供应商拒绝过高的 max_tokens，按该模型实际输出上限下调对应角色值。
PRIMARY_MODEL_COMPLETION_RESERVE=16384
PRIMARY_MODEL_TIMEOUT_SECONDS=300
BACKUP_MODEL_COMPLETION_RESERVE=32768
BACKUP_MODEL_TIMEOUT_SECONDS=450
# GLM 输出上限；与备用完成预留同步为 32768，供思考与正文共用
GLM_MODEL_MAX_OUTPUT_TOKENS=32768
# Token未知时按UTF-8消息/工具字节与完成预留扣账；不是严格Token或金额封顶

# 可选单价，按每百万输入/输出Token配置；没有默认价格/币种，空值为费用未知
# MODEL_PRICES_JSON={"your-model":{"input_per_million":1.0,"output_per_million":2.0,"currency":"USD"}}
# 可按provider:model分别配置主备价格；缓存读取已含于输入总量。
# 缓存价格示例：{"primary:your-model":{"input_per_million":1.0,"output_per_million":2.0,"cache_read_per_million":0.1,"currency":"USD"}}
# 写入单独计费时增加cache_write_per_million及cache_write_mode=included或additional，按供应商规则选择。
# 统计或必要价格缺失为费用未知；历史费用不重算，不代表供应商实际账单。
MODEL_PRICES_JSON=

# 报告任务全局并发；同一业务库仅允许一个Uvicorn worker
MAX_CONCURRENT_TASKS=2

# 可选独立评分模型；三项均未配置时优先使用 BACKUP_OPENAI_* 备用模型，
# 备用项也未配置才沿用当前主模型。配置不同模型可降低同模型评分偏差；Key只留本地。
EVALUATION_JUDGE_BASE_URL=
EVALUATION_JUDGE_MODEL=
EVALUATION_JUDGE_API_KEY=
# 独立评分单次超时（秒，5～300）；默认 60
EVALUATION_JUDGE_TIMEOUT_SECONDS=60

# 按端点主机/实际模型配置 json_schema、json_object 或 prompt；未确认能力不探测
STRUCTURED_OUTPUT_CAPABILITIES={}
