{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:smartbrief:construction:contracts:1",
  "title": "SmartBrief公共契约；实现状态按任务标注",
  "description": "各模块开工先将本契约转为 Pydantic/TS 并验证；v1 使用兼容适配。",
  "$defs": {
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "TaskOutcome": {
      "type": "object",
      "required": [
        "task_id",
        "execution_status",
        "quality_status",
        "forced_output"
      ],
      "properties": {
        "task_id": {
          "type": "string"
        },
        "execution_status": {
          "enum": [
            "queued",
            "running",
            "paused",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "quality_status": {
          "enum": [
            "pending",
            "passed",
            "rejected",
            "unavailable",
            "not_run",
            "unknown"
          ]
        },
        "forced_output": {
          "type": "boolean"
        },
        "error_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "description": "T03已实现：执行与审核质量独立；v2任务/报告data与v1新增字段，forced_output不代表通过。"
    },
    "Evidence": {
      "type": "object",
      "required": [
        "source_id",
        "task_id",
        "kind",
        "title",
        "excerpt",
        "retrieved_at"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "web",
            "document"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "excerpt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chunk_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "score": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_deleted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "web"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "document"
              }
            }
          },
          "then": {
            "required": [
              "document_id",
              "chunk_id"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "chunk_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false,
      "description": "T04-01已实现：任务内服务端编号，web URL限定无凭证HTTP(S)，不从历史报告反推来源。"
    },
    "Citation": {
      "type": "object",
      "required": [
        "source_id",
        "claim",
        "valid"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "valid": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "description": "T04-02已实现：声明段落与来源编号的结构映射；valid仅表示来源存在、未删除且能回溯，不证明事实真实性或语义支持。"
    },
    "MemoryEntry": {
      "additionalProperties": false,
      "properties": {
        "memory_id": {
          "minLength": 1,
          "title": "Memory Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "quality_status": {
          "enum": [
            "passed",
            "unknown"
          ],
          "title": "Quality Status",
          "type": "string"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "active",
            "unverified",
            "unavailable",
            "invalid",
            "deleted"
          ],
          "title": "Status",
          "type": "string"
        },
        "report_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Report Hash"
        },
        "index_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Hash"
        },
        "model_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Name"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Version"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Created At"
        },
        "invalid_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalid Reason"
        }
      },
      "required": [
        "memory_id",
        "task_id",
        "topic",
        "quality_status",
        "verified",
        "status",
        "report_hash",
        "model_name",
        "prompt_version",
        "created_at"
      ],
      "title": "MemoryEntry",
      "type": "object",
      "description": "T06-01已实现：SQLite权威准入，旧向量未验证；model_name为当前调用配置，供应商版本不可得为null。",
      "allOf": [
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "active"
              },
              "quality_status": {
                "const": "passed"
              },
              "report_hash": {
                "type": "string",
                "minLength": 1
              },
              "index_hash": {
                "type": "string",
                "minLength": 1
              },
              "prompt_version": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "status": {
                "not": {
                  "const": "active"
                }
              }
            }
          }
        }
      ]
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "minLength": 1,
          "title": "Call Id",
          "type": "string"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "agent": {
          "minLength": 1,
          "title": "Agent",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "success",
            "failed",
            "cancelled",
            "budget_exceeded"
          ],
          "title": "Status",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "usage_known": {
          "default": false,
          "title": "Usage Known",
          "type": "boolean"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "reserved_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reserved Tokens",
          "type": "integer"
        },
        "created_at": {
          "minLength": 1,
          "title": "Created At",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "USAGE_INTERRUPTED",
                "MODEL_FAILED",
                "MODEL_CANCELLED",
                "MODEL_TIMEOUT",
                "BUDGET_EXCEEDED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "call_id",
        "task_id",
        "agent",
        "model",
        "status",
        "duration_ms",
        "created_at"
      ],
      "title": "ModelUsage",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "usage_known": {
                "const": true
              }
            },
            "required": [
              "usage_known"
            ]
          },
          "then": {
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "input_tokens",
              "output_tokens"
            ]
          },
          "else": {
            "properties": {
              "input_tokens": {
                "type": "null"
              },
              "output_tokens": {
                "type": "null"
              },
              "estimated_cost": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "estimated_cost": {
                "type": "number"
              }
            },
            "required": [
              "estimated_cost"
            ]
          },
          "then": {
            "properties": {
              "usage_known": {
                "const": true
              },
              "currency": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "currency",
              "usage_known"
            ]
          },
          "else": {
            "properties": {
              "currency": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "EvaluationResult": {
      "type": "object",
      "required": [
        "case_id",
        "execution_success",
        "quality_passed",
        "citation_valid_rate",
        "failure_category"
      ],
      "properties": {
        "case_id": {
          "type": "string"
        },
        "execution_success": {
          "type": "boolean"
        },
        "quality_passed": {
          "type": "boolean"
        },
        "citation_valid_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "failure_category": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ResponseEnvelope": {
      "type": "object",
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {},
        "meta": {
          "type": "object",
          "required": [
            "request_id"
          ],
          "properties": {
            "request_id": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ErrorEnvelope": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "additionalProperties": false
    },
    "TaskCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "document_ids": {
          "items": {
            "pattern": "^[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Document Ids",
          "type": "array",
          "uniqueItems": true
        },
        "topic": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic"
      ],
      "title": "TaskCreateRequest",
      "type": "object"
    },
    "EvaluationRequest": {
      "type": "object",
      "required": [
        "suite_version",
        "feature_flags",
        "mode"
      ],
      "properties": {
        "suite_version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "offline",
            "online"
          ]
        },
        "feature_flags": {
          "type": "object",
          "required": [
            "rag",
            "memory",
            "review"
          ],
          "properties": {
            "rag": {
              "type": "boolean"
            },
            "memory": {
              "type": "boolean"
            },
            "review": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "AuthSession": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "enum": [
            "admin",
            "readonly"
          ]
        }
      },
      "additionalProperties": false,
      "description": "T02已实现，/api/v2/auth/session.data"
    },
    "UploadedDocument": {
      "type": "object",
      "required": [
        "source",
        "document_id",
        "display_name",
        "category",
        "added",
        "chunks"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "document_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "display_name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "upload",
            "template",
            "terminology"
          ]
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "chunks": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "T02已实现，既有v1上传响应兼容新增字段"
    },
    "DocumentSelection": {
      "additionalProperties": false,
      "properties": {
        "document_ids": {
          "items": {
            "pattern": "^[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Document Ids",
          "type": "array",
          "uniqueItems": true
        }
      },
      "title": "DocumentSelection",
      "type": "object"
    },
    "RetrievalOptions": {
      "additionalProperties": false,
      "properties": {
        "top_k": {
          "default": 5,
          "maximum": 20,
          "minimum": 1,
          "title": "Top K",
          "type": "integer"
        },
        "threshold": {
          "default": 0.35,
          "maximum": 1,
          "minimum": -1,
          "title": "Threshold",
          "type": "number"
        },
        "context_budget": {
          "default": 6000,
          "maximum": 24000,
          "minimum": 256,
          "title": "Context Budget",
          "type": "integer"
        }
      },
      "title": "RetrievalOptions",
      "type": "object"
    },
    "RetrievalRecord": {
      "additionalProperties": false,
      "properties": {
        "document_ids": {
          "items": {
            "pattern": "^[a-f0-9]{32}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Document Ids",
          "type": "array"
        },
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "query": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/RetrievalOptions"
        },
        "status": {
          "enum": [
            "not_selected",
            "matched",
            "no_hits",
            "below_threshold",
            "budget_excluded",
            "documents_missing",
            "embedding_failed",
            "index_failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "task_id",
        "query",
        "status"
      ],
      "title": "RetrievalRecord",
      "type": "object"
    },
    "MemoryPage": {
      "type": "object",
      "required": [
        "items",
        "total",
        "page",
        "page_size",
        "enabled",
        "counts"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MemoryEntry"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "enabled": {
          "type": "boolean"
        },
        "counts": {
          "type": "object",
          "required": [
            "active",
            "unverified",
            "unavailable",
            "invalid",
            "deleted"
          ],
          "properties": {
            "active": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            },
            "unavailable": {
              "type": "integer",
              "minimum": 0
            },
            "invalid": {
              "type": "integer",
              "minimum": 0
            },
            "deleted": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "RegenerationResult": {
      "type": "object",
      "required": [
        "task_id",
        "topic",
        "status",
        "regenerated_from"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running"
          ],
          "description": "T08起真实排队；running为T06历史兼容"
        },
        "regenerated_from": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "MemoryDeleteResult": {
      "type": "object",
      "required": [
        "memory_id",
        "deleted",
        "status"
      ],
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1
        },
        "deleted": {
          "type": "boolean"
        },
        "status": {
          "const": "deleted"
        }
      },
      "additionalProperties": false
    },
    "UsageReport": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ModelUsage"
          },
          "title": "Items",
          "type": "array"
        },
        "call_count": {
          "title": "Call Count",
          "type": "integer"
        },
        "blocked_count": {
          "title": "Blocked Count",
          "type": "integer"
        },
        "unknown_calls": {
          "title": "Unknown Calls",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Output Tokens"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "estimated_costs": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Estimated Costs",
          "type": "object"
        },
        "cost_complete": {
          "title": "Cost Complete",
          "type": "boolean"
        },
        "budget_limit_tokens": {
          "title": "Budget Limit Tokens",
          "type": "integer"
        },
